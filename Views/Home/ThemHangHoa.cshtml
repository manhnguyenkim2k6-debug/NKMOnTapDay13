@model NguyenKimManh_241230790.Models.ThemHangHoaViewModel

@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";
}

<div class="main">
    <div class="content">

        <h3>Nguyễn Kim Mạnh</h3>
        <h4>Thêm Hàng Hóa Mới</h4>

        <hr />

        <form asp-controller="Home"
              asp-action="ThemHangHoa"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div>
                <label asp-for="MaLoai"></label>

                <select asp-for="MaLoai"
                        asp-items="ViewBag.DanhSachLoai">
                    <option value="">-- Chọn loại hàng --</option>
                </select>

                <span asp-validation-for="MaLoai"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="TenHang"></label>

                <input asp-for="TenHang" />

                <span asp-validation-for="TenHang"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Gia"></label>

                <input asp-for="Gia" type="number" step="any" />

                <span asp-validation-for="Gia"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Anh"></label>

                <input asp-for="Anh" />

                <span asp-validation-for="Anh"
                      class="text-danger"></span>
            </div>

            <div>
                <button type="submit">Create</button>
            </div>

        </form>

    </div>
</div>

<style>
    .text-danger {
        color: red;
        display: block;
        font-size: 13px;
    }

    form > div {
        margin-bottom: 10px;
    }

    form label {
        display: block;
        margin-bottom: 4px;
    }
</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}